# Copy to terraform.tfvars for local runs. Jenkins sets these via TF_VAR_* env vars.
aws_region           = "us-east-1"
dockerhub_repository = "your-dockerhub-user/ecs-demo"
image_tag            = "latest"

# Vertical scaling
task_cpu    = 256
task_memory = 512

# Horizontal scaling
desired_count = 2
min_capacity  = 1
max_capacity  = 4
