# Copy to terraform.tfvars for local runs. Jenkins sets these via TF_VAR_* env vars.
aws_region           = "us-east-1"
dockerhub_repository = "your-dockerhub-user/ecs-demo"
image_tag            = "latest"

# Vertical scaling (size of each task)
task_cpu    = 256
task_memory = 512

# Horizontal scaling (number of tasks)
desired_count = 2
